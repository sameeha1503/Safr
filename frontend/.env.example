# Browser-safe Supabase project connection. RLS must stay enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only: admin access bypassing RLS for safe server operations
SUPABASE_SERVICE_ROLE_KEY=

# Server only: never prefix a Gemini secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public development services need no API keys; configure your own services for production.
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional failover; used after a failed primary within a six-second total budget.
OVERPASS_FALLBACK_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Routing engine provider: valhalla (default, supports car, scooter, bicycle, walking) | osrm
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de

# Map tile styles (optional — defaults to free OpenFreeMap styles)
# VITE_MAP_STYLE_STREETS=https://tiles.openfreemap.org/styles/liberty
# VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# SafeTag Notification settings (mock or live mode, active channels: whatsapp or whatsapp,sms)
NOTIFY_MODE=mock
NOTIFY_CHANNELS=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
